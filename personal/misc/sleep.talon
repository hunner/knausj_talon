mode: all
-
drowse: speech.disable()
voice sleep: speech.disable()
voice wake: speech.enable()
#key(cmd-alt-ctrl-space): speech.toggle()
key(cmd-alt-ctrl-shift-tab): speech.toggle()
key(super-alt-ctrl-shift-tab): speech.toggle()
#key(§:down): speech.enable()
#key(§:up): speech.disable()
key(§): speech.toggle()
key(f9): speech.toggle()
