os: linux
-
# layouts
#toggle (float | floating): key(alt-shift-t)
#toggle (amethyst | tiling): key(ctrl-alt-shift-t)
next layout: key(super-space)
last layout: key(super-shift-space)
#show (layouts | layout): key(alt-shift-i)
#tall layout: key(alt-shift-a)
#wide layout: key(alt-shift-s)
#fix layout: key(alt-shift-z)
#(full | full screen) layout: key(alt-shift-d)
#(call on | column) layout: key(alt-shift-f)

# windows
slot next: key("super-j")
slot (preev | last | previous): key("super-k")
move slot next: key("super-shift-j")
move slot (preev | last | previous): key("super-shift-k")
move slot main: key("super-shift-enter")

# screens
go screen one: key('super-o')
go screen two: key('super-e')
move screen one: key('super-shift-o')
move screen two: key('super-shift-e')

# spaces
(ghost | go space) one: key("super-1")
(ghost | go space) two: key("super-2")
(ghost | go space) three: key("super-3")
(ghost | go space) four: key("super-4")
(ghost | go space) five: key("super-5")
(ghost | go space) six: key("super-6")
(ghost | go space) seven: key("super-7")
(ghost | go space) eight: key("super-8")
(ghost | go space) nine: key("super-9")
(ghost | go space) ten: key("super-0")
move space one: key('super-shift-1')
move space two: key('super-shift-2')
move space three: key('super-shift-3')
move space four: key('super-shift-4')
move space five: key('super-shift-5')
move space six: key('super-shift-6')
move space seven: key('super-shift-7')
move space eight: key('super-shift-8')
move space nine: key('super-shift-9')
move space ten: key('super-shift-0')
