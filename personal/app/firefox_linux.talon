os: linux
app: firefox
-
down tab: key(cmd-shift-])
up tab: key(cmd-shift-[)
go next tab: key(cmd-shift-])
go last tab: key(cmd-shift-[)

toggle reader: key(cmd-alt-r)
copy (URL | location): key(ctrl-l ctrl-c)

zoom out: key(ctrl-=)
zoom in: key(ctrl-+)
zoom clear: key(ctrl-0)

toggle debug: key(ctrl-shift-i)
debug network: key(ctrl-shift-e)
debug console: key(ctrl-shift-k)

tab (left|up): key(ctrl-pageup)
tab (right|down): key(ctrl-pagedown)
