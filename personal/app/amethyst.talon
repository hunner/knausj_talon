user.running: amethyst
os: mac
-
# layouts
toggle (float | floating): key(alt-shift-f)
relaunch amethyst: key(alt-shift-ctrl-z)
toggle focus follows mouse: key(alt-shift-ctrl-x)
next layout: key(alt-shift-space)
last layout: key(alt-shift-ctrl-space)
show (layouts | layout): key(alt-shift-i)
tall layout: key(alt-shift-g)
bsp layout: key(alt-shift-c)
(full | full screen) layout: key(alt-shift-r)

# windows
slot next: key("alt-shift-j")
slot (preev | last | previous): key("alt-shift-k")
slot bigger: key("alt-shift-h")
slot smaller: key("alt-shift-l")
move slot main: key("alt-shift-ctrl-enter")

# screens
go screen one: key("alt-shift-o")
go screen two: key("alt-shift-e")
go screen three: key("alt-shift-u")
move screen one: key("alt-shift-ctrl-o")
move screen two: key("alt-shift-ctrl-e")
move screen three: key("alt-shift-ctrl-u")

# spaces
(ghost | go space) one: key("ctrl-1")
(ghost | go space) two: key("ctrl-2")
(ghost | go space) three: key("ctrl-3")
(ghost | go space) four: key("ctrl-4")
(ghost | go space) five: key("ctrl-5")
(ghost | go space) six: key("ctrl-6")
(ghost | go space) seven: key("ctrl-7")
(ghost | go space) eight: key("ctrl-8")
(ghost | go space) nine: key("ctrl-9")
(ghost | go space) ten: key("ctrl-0")
move space one: key("alt-shift-ctrl-1")
move space two: key("alt-shift-ctrl-2")
move space three: key("alt-shift-ctrl-3")
move space four: key("alt-shift-ctrl-4")
move space five: key("alt-shift-ctrl-5")
move space six: key("alt-shift-ctrl-6")
move space seven: key("alt-shift-ctrl-7")
move space eight: key("alt-shift-ctrl-8")
move space nine: key("alt-shift-ctrl-9")
move space ten: key("alt-shift-ctrl-0")
